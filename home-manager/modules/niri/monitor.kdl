// -----------------------------------------------------------------------------
// NyxNiri 显示器配置文件 (monitor.kdl)
// -----------------------------------------------------------------------------
// 说明：此文件用于存放针对您个人硬件设备的物理显示器配置（如分辨率、刷新率、缩放与位置）。
// 
// 提示：默认情况下无需在此填写任何内容，Niri 会自动识别并以推荐设置驱动所有连接的显示器。
// 如需针对特定屏幕进行个性化调整，请参考以下示例取消注释并修改。
// 官方 Output 配置文档: https://github.com/YaLteR/niri/wiki/Configuration:-Outputs
// -----------------------------------------------------------------------------

// -----------------------------------------------------------------------------
// 内置屏幕 BOE NE156QHM-NY1 (eDP-1, 2560x1440)
// -----------------------------------------------------------------------------
// 该面板的 EDID 把 2560x1440@60.000 标为 preferred，而 niri 在不指定 mode 时
// 就采用 preferred —— 于是一直只能跑 60Hz。面板实际还支持 2560x1440@165.001。
// 显式钉住 165Hz，解除 60Hz 上限。
//
// 可用模式用 `niri msg outputs` 查看；只想临时改、不重新部署时：
//   niri msg output eDP-1 mode "2560x1440@165.001"
// 切回 60Hz：
//   niri msg output eDP-1 mode "2560x1440@60.000"
//
// 这里不写 scale：niri 的 scale 默认为 auto，按面板物理尺寸推算
//（本屏 340x190mm → 1.5，逻辑分辨率 1706x960），写死反而挡掉自动调整。
// 该屏报告 vrr_supported，若要可变刷新率可另加 variable-refresh-rate。
output "eDP-1" {
    mode "2560x1440@165.001"
}

// 示例 1: 笔记本内置屏幕 (标准 1080p@60Hz)
// output "eDP-1" {
//     mode "1920x1080@60.000"
//     scale 1.0
//     position x=0 y=0
// }

// 示例 2: 外接高刷显示器 (2K 144Hz 开启 VRR)
// output "DP-1" {
//     mode "2560x1440@144.000"
//     scale 1.0
//     position x=1920 y=0
//     variable-refresh-rate
// }
